# ============================================================
# Omniradar — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual keys.
#   cp .env.example .env
#
# NEVER commit .env to git. Only .env.example is tracked.
# ============================================================

# --- REQUIRED ---

# Anthropic Claude API Key (used for AI trend analysis + brand briefs)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Telegram Bot (used for daily alert push)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- OPTIONAL (enhance data collection) ---

# YouTube Data API v3 keys (rotated across 3 keys to avoid quota limits)
# Get at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY_1=""
YOUTUBE_API_KEY_2=""
YOUTUBE_API_KEY_3=""

# Reddit API (legacy — not currently used, reddit_public_collector uses public JSON API)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT=TrendRadarBot/1.0
